{
  "version": 2,
  "configurePresets": [
    {
      "name": "shared",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/shared"
    },
    {
      "name": "test",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/test",
      "cacheVariables": {
        "TEST": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "shared",
      "configurePreset": "shared"
    },
    {
      "name": "test",
      "configurePreset": "test"
    }
  ]
}