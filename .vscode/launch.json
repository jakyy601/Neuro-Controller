{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with GDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main", // Path to your executable
            "args": [
                "2",
                "3",
                "0.01",
                "5000",
                "3",
                "1",
                "1.0",
                "test.csv",
                "1"
            ], // Replace with your arguments
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb", // Path to your gdb
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python: Test parameters for NC",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/testParameters.py",
            "console": "integratedTerminal"
        }
    ]
}